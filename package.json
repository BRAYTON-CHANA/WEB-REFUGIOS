{
  "name": "web-refugios",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/dev.js",
    "dev:api": "node --watch server.js",
    "dev:web": "npm run dev --prefix frontend",
    "setup": "npm install && npm install --prefix frontend",
    "build": "npm run build --prefix frontend",
    "db:setup": "node scripts/run-sql.js",
    "db:migrate": "node scripts/run-sql-migrations.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.2.0",
    "pg": "^8.16.3"
  }
}
