# === Servidor Express ===
PORT=3001
# Origen permitido por CORS (en producción, la URL del frontend)
CORS_ORIGIN=*

# === Base de datos ===
# Motor: postgres (el driver mssql sigue disponible, pero no hay scripts SQL Server)
DB_CLIENT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=REFUGIOS_DB
DB_USER=refugios_user
DB_PASSWORD=cambia_esto

# DB_SSL=false   (true para servicios en la nube)

# Para que db:setup cree la BD y el usuario (opcional: usuario postgres)
# DB_ADMIN_USER=
# DB_ADMIN_PASSWORD=

# === Supabase Storage (archivos de expedientes; solo backend) ===
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...   (nunca en el frontend ni en el repo)
# STORAGE_BUCKET=expedientes          (bucket privado; se crea solo)

# === JWT ===
JWT_SECRET=genera_un_secreto_largo_aleatorio
JWT_EXPIRES_IN=8h

# === Usuarios iniciales (los crea db:setup; sin clave no se crea; deben cambiarla al entrar) ===
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambia_esto_admin
EDITOR_PASSWORD=cambia_esto_editor
LECTOR_PASSWORD=cambia_esto_lector
